DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ai_systems
OPENAI_API_KEY=replace-me
WORLD_NEWS_API_KEY=replace-me
# Required for the incident log-stream classifier.
TYPESAFE_API_KEY=replace-me
# Optional for future agent web-search tools; not used by current incident tools.
# TAVILY_API_KEY=replace-me

# Optional: keep local traces local while developing.
LOGFIRE_SEND_TO_LOGFIRE=false
# To export spans, set LOGFIRE_API_KEY to a project key with Send telemetry
# permission and change LOGFIRE_SEND_TO_LOGFIRE=true. LOGFIRE_TOKEN also works.
