  "policies": [
    {
      "policy_id": "cancellation",
      "revision": "v1",
      "locator": "rules",
      "title": "Order cancellation",
      "text": "An order may be cancelled after customer confirmation only while paid and unfulfilled. A created shipping label closes this automatic cancellation route. Shipped or delivered orders require human review. Cancellation does not authorize the AI to issue a refund; payment adjustments are handled by a human.",
      "effective_on": "2026-09-01"
    },
    {
      "policy_id": "address",
      "revision": "v1",
      "locator": "rules",
      "title": "Shipping address correction",
      "text": "A customer may confirm a replacement US shipping address only before a shipping label is created. Confirm the full replacement address and recheck order state at execution. After label creation, create a case for human review; never promise carrier interception.",
      "effective_on": "2026-09-01"
    },
    {
      "policy_id": "returns",
      "revision": "v1",
      "locator": "rules",
      "title": "Returns and refund review",
      "text": "Customers may request return review within 30 calendar days after delivery. Record order ID, affected items, condition, and reason. Damaged or incorrect deliveries should be reported promptly with photographs when available. Create a human-review case, including requests outside the standard window. A case is not return approval or a refund promise. The AI cannot issue refunds.",
      "effective_on": "2026-09-01"
    },
    {
      "policy_id": "warranty",
      "revision": "v1",
      "locator": "rules",
      "title": "Warranty and damaged equipment",
      "text": "Create a human-review case with the order ID, affected product, symptoms, damage description, and supporting evidence. The retailer review window is one year from delivery for a reported equipment fault; eligibility and manufacturer coverage are verified by a human. Accidental damage is not automatically covered. Do not invent a manufacturer warranty or promise replacement.",
      "effective_on": "2026-09-01"
    },
    {
      "policy_id": "handoff",
      "revision": "v1",
      "locator": "rules",
      "title": "Human support handoff",
      "text": "Create a human-review case for an explicit human request, conflicting policy, an unsupported action, low confidence, or repeated tool failures. Include relevant conversation facts and source IDs, avoid unrelated personal data, and give the customer the case ID only after the case is saved.",
      "effective_on": "2026-09-01"
    }
  ],
