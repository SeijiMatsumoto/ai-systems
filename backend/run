#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -x "$repo_root/.venv/bin/python" ]]; then
  echo "Missing .venv. See the first-time setup in README.md." >&2
  exit 1
fi
if [[ ! -f "$repo_root/backend/.env" ]]; then
  echo "Missing backend/.env. See the first-time setup in README.md." >&2
  exit 1
fi

cd "$repo_root"
exec .venv/bin/python -m uvicorn backend.main:app \
  --reload --reload-dir backend --host 127.0.0.1 --port 8000
